RELAY_BASE_URL=ws://localhost:8787
RELAY_ROOM=demo
RELAY_PATHS=/webhook/*
RELAY_TARGET_URL=http://localhost:3000
RELAY_TIMEOUT_MS=15000
RELAY_RECONNECT_DELAY_MS=1000
RELAY_HEALTH_PORT=8080

# Logging
# RELAY_LOG_LEVEL can be: trace|debug|info|warn|error|fatal
RELAY_LOG_LEVEL=info
# Pretty print logs when not in production (set to "false" to disable)
RELAY_LOG_PRETTY=true
