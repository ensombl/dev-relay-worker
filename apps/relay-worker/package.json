{
  "name": "@ensombl/relay-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ensombl/relay-protocol build && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "pnpm --filter @ensombl/relay-protocol build && wrangler dev",
    "start": "pnpm dev",
    "test": "pnpm --filter @ensombl/relay-protocol build && vitest run",
    "coverage": "pnpm --filter @ensombl/relay-protocol build && vitest run --coverage",
    "typecheck": "pnpm --filter @ensombl/relay-protocol build && tsc --noEmit -p tsconfig.json",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ensombl/relay-protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "typescript": "^5.9.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.33.2"
  }
}
