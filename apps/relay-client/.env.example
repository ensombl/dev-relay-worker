RELAY_BASE_URL=ws://localhost:8787
RELAY_ROOM=demo
RELAY_PATHS=/webhook/*
TARGET_URL=http://localhost:3000
TIMEOUT_MS=15000
RECONNECT_DELAY_MS=1000
HEALTH_PORT=8080

# Logging
# LOG_LEVEL can be: trace|debug|info|warn|error|fatal
LOG_LEVEL=info
# Pretty print logs when not in production (set to "false" to disable)
LOG_PRETTY=true
