{
  "name": "@ensombl/relay-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ensombl/relay-protocol build && CI=1 wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm --filter @ensombl/relay-protocol build && CI=1 wrangler deploy",
    "dev": "pnpm --filter @ensombl/relay-protocol build && CI=1 wrangler dev",
    "start": "pnpm dev",
    "test": "pnpm --filter @ensombl/relay-protocol build && vitest run",
    "coverage": "pnpm --filter @ensombl/relay-protocol build && vitest run --coverage",
    "typecheck": "pnpm --filter @ensombl/relay-protocol build && tsc --noEmit -p tsconfig.json",
    "cf-typegen": "CI=1 wrangler types"
  },
  "dependencies": {
    "@ensombl/relay-protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "typescript": "^6.0.3",
    "vitest": "~4.1.8",
    "wrangler": "4.99.0"
  }
}
